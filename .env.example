# Copy to .env.local and fill in. Validated at startup by src/lib/env.ts —
# the app fails fast with a readable error rather than throwing deep in a request.

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely — never expose to the browser and never
# prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for Stripe redirect URLs, sitemap,
# and robots. Must be the real origin in production or checkout returns users
# to the wrong host.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=
# From `stripe listen` in development, or the endpoint's signing secret in
# production. Without it the webhook rejects every event.
STRIPE_WEBHOOK_SECRET=

# One price per plan per billing interval. All four are required: an
# unrecognised price ID cannot be mapped to a tier, so a subscriber on a
# missing price would fail to resolve.
STRIPE_PLUS_MONTHLY_PRICE_ID=
STRIPE_PLUS_ANNUAL_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
